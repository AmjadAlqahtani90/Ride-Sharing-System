! !!Ride methodsFor: 'nil' stamp: '2026-10-03T06:53:39.389745-07:00'!
initializeWithID: anID pickup: aPickup dropoff: aDropoff distance: aDistance
    rideID := anID.
    pickupLocation := aPickup.
    dropoffLocation := aDropoff.
    distance := aDistance.
    ^ self
! !!Ride methodsFor: 'nil' stamp: '2026-10-03T06:53:39.4343-07:00'!
rideID
    ^ rideID
! !!Ride methodsFor: 'nil' stamp: '2026-10-03T06:53:39.434865-07:00'!
pickupLocation
    ^ pickupLocation
! !!Ride methodsFor: 'nil' stamp: '2026-10-03T06:53:39.436005-07:00'!
dropoffLocation
    ^ dropoffLocation
! !!Ride methodsFor: 'nil' stamp: '2026-10-03T06:53:39.436534-07:00'!
distance
    ^ distance
! !!Ride methodsFor: 'nil' stamp: '2026-10-03T06:53:39.43699-07:00'!
fare
    self subclassResponsibility
! !!Ride methodsFor: 'nil' stamp: '2026-10-03T06:53:39.437385-07:00'!
rideDetails
    self subclassResponsibility
! !!StandardRide methodsFor: 'nil' stamp: '2026-10-03T06:53:39.438104-07:00'!
fare
    ^ self distance * 2
! !!StandardRide methodsFor: 'nil' stamp: '2026-10-03T06:53:39.438852-07:00'!
rideDetails
    Stdio stdout
        nextPutAll: 'Standard    ';
        nextPutAll: self rideID printString;
        nextPutAll: '        ';
        nextPutAll: self pickupLocation;
        nextPutAll: '        ';
        nextPutAll: self dropoffLocation;
        nextPutAll: '        ';
        nextPutAll: self distance printString;
        nextPutAll: '          $';
        nextPutAll: self fare printString;
        lf
! !!PremiumRide methodsFor: 'nil' stamp: '2026-10-03T06:53:39.439537-07:00'!
fare
    ^ self distance * 4
! !!PremiumRide methodsFor: 'nil' stamp: '2026-10-03T06:53:39.440171-07:00'!
rideDetails
    Stdio stdout
        nextPutAll: 'Premium     ';
        nextPutAll: self rideID printString;
        nextPutAll: '        ';
        nextPutAll: self pickupLocation;
        nextPutAll: '              ';
        nextPutAll: self dropoffLocation;
        nextPutAll: '       ';
        nextPutAll: self distance printString;
        nextPutAll: '           $';
        nextPutAll: self fare printString;
        lf
! !!Driver methodsFor: 'nil' stamp: '2026-10-03T06:53:39.44096-07:00'!
initializeWithID: anID name: aName rating: aRating
    driverID := anID.
    name := aName.
    rating := aRating.
    assignedRides := OrderedCollection new.
    ^ self
! !!Driver methodsFor: 'nil' stamp: '2026-10-03T06:53:39.441362-07:00'!
addRide: aRide
    assignedRides add: aRide
! !!Driver methodsFor: 'nil' stamp: '2026-10-03T06:53:39.442077-07:00'!
getDriverInfo
    Stdio stdout
        lf;
        nextPutAll: '=== DRIVER INFORMATION ==='; lf;
        nextPutAll: 'Driver ID    Name                Rating'; lf;
        nextPutAll: '---------------------------------------'; lf;
        nextPutAll: driverID printString;
        nextPutAll: '            ';
        nextPutAll: name;
        nextPutAll: '          ';
        nextPutAll: rating printString;
        lf;
        lf;
        nextPutAll: 'Assigned Rides:'; lf;
        nextPutAll: 'Type        Ride ID    Pickup            Dropoff        Distance    Fare'; lf;
        nextPutAll: '--------------------------------------------------------------------------'; lf.

    assignedRides do: [ :eachRide |
        eachRide rideDetails
    ]
! !!Rider methodsFor: 'nil' stamp: '2026-10-03T06:53:39.442747-07:00'!
initializeWithID: anID name: aName
    riderID := anID.
    name := aName.
    requestedRides := OrderedCollection new.
    ^ self
! !!Rider methodsFor: 'nil' stamp: '2026-10-03T06:53:39.443098-07:00'!
requestRide: aRide
    requestedRides add: aRide
! !!Rider methodsFor: 'nil' stamp: '2026-10-03T06:53:39.443703-07:00'!
viewRides
    Stdio stdout
        lf;
        nextPutAll: '=== RIDER INFORMATION ==='; lf;
        nextPutAll: 'Rider ID     Name'; lf;
        nextPutAll: '------------------------------'; lf;
        nextPutAll: riderID printString;
        nextPutAll: '           ';
        nextPutAll: name;
        lf;
        lf;
        nextPutAll: 'Ride History:'; lf;
        nextPutAll: 'Type        Ride ID    Pickup            Dropoff        Distance    Fare'; lf;
        nextPutAll: '--------------------------------------------------------------------------'; lf.

    requestedRides do: [ :eachRide |
        eachRide rideDetails
    ]
! !